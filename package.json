{
  "name": "mv-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
