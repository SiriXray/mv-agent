# Local single-user service. Live requests require BOTH this switch and UI confirmation.
PORT=5410
ENABLE_LIVE_GENERATION=false
# New Vidu models are stored but excluded until their constraints are confirmed.
VIDU_API_KEY=
# Legacy viduq4-preview credential, kept separate from the new models.
VIDU_PREVIEW_API_KEY=
DASHSCOPE_API_KEY=
WAN_API_KEY=
# Stored only: never retried automatically against DashScope.
DASHSCOPE_BACKUP_API_KEY=
MINIMAX_KEY=
# HTTP proxy is never called; incomplete response protocol remains disabled.
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=
REVERSE_PROMPT_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
REVERSE_PROMPT_MODEL=qwen-vl-max
# Remote planner. Choose responses or chat to match the configured API.
# Nothing is called on startup.
PLANNER_URL=
PLANNER_API_KEY=
PLANNER_MODEL=
PLANNER_PROTOCOL=responses
# Reuse a vision-capable GPT connection, or configure a separate image model.
# When using a text-only planner (e.g. a DeepSeek text model), set false.
VISION_USE_PLANNER=true
VISION_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_PROTOCOL=responses
# Optional reserved MiniMax VLM profile; manual activation only.
# These fields are NOT consumed by the current app and do not enable fallback.
# Keep the video MINIMAX_KEY separate.
MINIMAX_VISION_API_KEY=
MINIMAX_VISION_URL=https://api.minimax.cn/v1/chat/completions
MINIMAX_VISION_MODEL=MiniMax-M3.1-Flash
MINIMAX_VISION_PROTOCOL=chat
# FFmpeg/ffprobe executable names or absolute paths
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# MIX is excluded per the latest user instruction; undocumented models are not registered.
